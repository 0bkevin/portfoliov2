---
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import {
  createBreadcrumbSchema,
  createCollectionPageSchema,
  createWebsiteSchema,
  seoConfig,
} from "@lib/seo";

const projects = (await getCollection("projects")) as CollectionEntry<"projects">[];

const sortedProjects = projects.sort(
  (a, b) => Number(b.data.pubYear) - Number(a.data.pubYear)
);

const featuredProject = sortedProjects[0];

const pageTitle = "Backend, Infrastructure, AI & Full-Stack Projects | Kevin Bravo";
const pageDescription =
  "Explore backend, infrastructure, AI engineering, and full-stack case studies by Kevin Bravo, including product platforms, dashboards, data-heavy systems, and technical architecture work.";
const pagePath = "/projects";

const webpageSchema = createCollectionPageSchema({
  id: `${seoConfig.siteUrl}/projects#collection`,
  name: pageTitle,
  description: pageDescription,
  url: new URL(pagePath, Astro.site).toString(),
  about: {
    "@type": "Person",
    "@id": `${seoConfig.siteUrl}/#person`,
    name: seoConfig.author.name,
    url: seoConfig.author.url,
    jobTitle: seoConfig.author.jobTitle,
  },
});

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Kevin Bravo project archive",
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: sortedProjects.length,
  itemListElement: sortedProjects.map((project, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: new URL(`/projects/${project.id}`, Astro.site).toString(),
    name: project.data.title,
    description: project.data.description,
  })),
};

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", item: "/" },
  { name: "Projects", item: pagePath },
]);

const structuredData = [
  createWebsiteSchema(),
  webpageSchema,
  itemListSchema,
  breadcrumbSchema,
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical={pagePath}
  image={featuredProject?.data.image.url ?? seoConfig.defaultOgImage}
  imageAlt={featuredProject?.data.image.alt ?? "Kevin Bravo software engineering portfolio"}
  structuredData={structuredData}
  tags={["software engineering", "projects", "case studies", "portfolio", "backend", "infrastructure", "AI engineering", "full-stack"]}
>
  <div class="home-col min-h-screen pb-20 pt-6">
    <PageHeader label="projects · case studies" title="Things I've built at work">
      Case studies from production platforms and internal systems, with the context behind the architecture, the data, and
      the product decisions.
    </PageHeader>

    <section aria-labelledby="case-studies-heading">
      <div class="mb-2 flex items-center justify-between font-mono text-[12px] lowercase text-surface-500">
        <h2 id="case-studies-heading">all case studies</h2>
        <span>{sortedProjects.length} projects</span>
      </div>

      <ol class="case-index">
        {
          sortedProjects.map((project, index) => (
            <li>
              <a
                href={project.data.studyCaseUrl ?? `/projects/${project.id}`}
                class="case-row group grid gap-5 border-b border-surface-200 py-8 dark:border-surface-800/70 md:grid-cols-[3rem_15rem_1fr] md:items-start md:gap-6"
              >
                <span class="font-mono text-[13px] text-surface-400 transition-colors group-hover:text-accent-500 dark:text-surface-600 dark:group-hover:text-accent-400">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="aspect-[16/10] overflow-hidden rounded-lg border border-surface-200 bg-surface-100 dark:border-surface-800 dark:bg-surface-900">
                  <img
                    src={project.data.image.url}
                    alt={project.data.image.alt}
                    class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.25,1,0.5,1)] group-hover:scale-[1.04]"
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </div>
                <div class="min-w-0">
                  <p class="font-mono text-[12px] lowercase text-surface-500">
                    {project.data.pubYear.getFullYear()}
                    {project.id === featuredProject?.id && (
                      <span class="ml-2 inline-flex items-center gap-1.5 text-accent-500 dark:text-accent-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true" />
                        featured
                      </span>
                    )}
                  </p>
                  <h3 class="case-title mt-2 text-2xl font-bold tracking-tight text-surface-900 dark:text-surface-100 md:text-3xl">
                    {project.data.title}
                  </h3>
                  <p class="mt-3 max-w-xl text-sm leading-relaxed text-surface-600 dark:text-surface-400 md:text-[15px]">
                    {project.data.description}
                  </p>
                  <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[12px] lowercase text-surface-500">
                    {project.data.tags.slice(0, 4).map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                  <span class="mt-5 inline-flex items-center gap-1.5 font-mono text-[13px] lowercase text-accent-500 dark:text-accent-400">
                    read case study
                    <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Layout>

<style>
  .case-title {
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .case-row {
    transition: opacity 0.3s;
  }

  @media (hover: hover) and (min-width: 768px) {
    .case-index:hover .case-row:not(:hover) {
      opacity: 0.55;
    }

    .case-row:hover .case-title {
      transform: translateX(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-title {
      transition: none;
    }
  }
</style>
