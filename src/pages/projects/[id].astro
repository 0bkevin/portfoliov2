---
import Layout from "@layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { createBreadcrumbSchema, createProjectSchema } from "@lib/seo";

export const prerender = true;

export async function getStaticPaths() {
  const projects = (await getCollection("projects")) as CollectionEntry<"projects">[];

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props as Props;
const { Content } = await render(project);


const projectYear = project.data.pubYear.getFullYear();
const pathname = `/projects/${project.id}`;
const technologies = project.data.technologies ?? project.data.tags;
const seoTitle = project.data.seoTitle ?? `${project.data.title} Case Study | Kevin Bravo`;
const seoDescription = project.data.seoDescription ?? project.data.description;

const projectSchema = createProjectSchema({
  name: project.data.title,
  description: project.data.description,
  url: pathname,
  image: project.data.image.url,
  datePublished: project.data.pubYear,
  programmingLanguage: technologies,
  keywords: project.data.tags,
  ...(project.data.repoUrl ? { codeRepository: project.data.repoUrl } : {}),
  ...(project.data.demoUrl ? { demoUrl: project.data.demoUrl } : {}),
});

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", item: "/" },
  { name: "Projects", item: "/projects" },
  { name: project.data.title, item: pathname },
]);

const structuredData = [projectSchema, breadcrumbSchema];
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={project.data.image.url}
  imageAlt={project.data.image.alt}
  canonical={pathname}
  type="website"
  structuredData={structuredData}
  section="Projects"
  tags={project.data.tags}
>
  <article class="min-h-screen pb-16 pt-6 md:pb-20">
    <div class="home-col">
      <header class="mb-12 md:mb-14">
        <a
          href="/projects"
          class="group mb-10 inline-flex items-center gap-1.5 font-mono text-[13px] lowercase text-surface-500 transition-colors hover:text-surface-900 dark:hover:text-surface-100"
        >
          <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
          all projects
        </a>
        <p class="section-heading fade-in-up" style="--d: 0ms">
          <span><span class="section-num" aria-hidden="true">//</span> case study · <time datetime={project.data.pubYear.toISOString()}>{projectYear}</time></span>
        </p>
        <h1 class="fade-in-up text-4xl font-bold leading-[1.05] tracking-tight text-surface-900 dark:text-surface-100 md:text-6xl" style="--d: 60ms">
          {project.data.title}
        </h1>
        <p class="fade-in-up mt-6 max-w-2xl text-lg leading-relaxed text-surface-600 dark:text-surface-400 md:text-xl md:font-light" style="--d: 120ms">
          {project.data.description}
        </p>
        <ul class="fade-in-up mt-6 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[12px] lowercase text-surface-500" style="--d: 180ms">
          {project.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      </header>

      <div class="fade-in-up mb-14 aspect-video w-full overflow-hidden rounded-lg border border-surface-200 bg-surface-100 dark:border-surface-800 dark:bg-surface-900 md:mb-20" style="--d: 220ms">
        <img
          src={project.data.image.url}
          alt={project.data.image.alt}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="grid items-start gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,2.6fr)] md:gap-14">
        <aside class="hidden flex-col gap-10 md:sticky md:top-24 md:flex">
          <dl class="flex flex-col gap-5 font-mono text-[13px]">
            <div>
              <dt class="lowercase text-surface-500">timeline</dt>
              <dd class="mt-1 text-surface-900 dark:text-surface-100">{projectYear}</dd>
            </div>
            <div>
              <dt class="lowercase text-surface-500">category</dt>
              <dd class="mt-1 lowercase text-surface-900 dark:text-surface-100">{project.data.tags[0] || "engineering"}</dd>
            </div>
            <div>
              <dt class="lowercase text-surface-500">stack</dt>
              <dd class="mt-1 lowercase leading-relaxed text-surface-900 dark:text-surface-100">{technologies.join(", ") || "n/a"}</dd>
            </div>
          </dl>

          {(project.data.demoUrl || project.data.repoUrl) && (
            <div class="flex flex-col gap-3">
              {project.data.demoUrl && (
                <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-between gap-2 rounded-lg bg-surface-900 px-5 py-3 font-mono text-[13px] lowercase text-white transition-colors hover:bg-surface-800 dark:bg-surface-100 dark:text-surface-900 dark:hover:bg-surface-200">
                  live demo <span class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
                </a>
              )}
              {project.data.repoUrl && (
                <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center justify-between gap-2 rounded-lg border border-surface-200 px-5 py-3 font-mono text-[13px] lowercase text-surface-600 transition-colors hover:border-surface-300 hover:text-surface-900 dark:border-surface-800 dark:text-surface-400 dark:hover:border-surface-700 dark:hover:text-surface-200">
                  source code <span class="transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          )}
        </aside>

        <div class="prose prose-neutral dark:prose-invert max-w-3xl
          prose-headings:tracking-tight prose-headings:font-bold prose-headings:text-surface-900 dark:prose-headings:text-surface-100
          prose-h1:text-3xl prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-6 prose-h3:text-xl
          prose-p:text-surface-600 dark:prose-p:text-surface-400 prose-p:leading-relaxed prose-p:mb-6
          prose-a:text-surface-900 dark:prose-a:text-surface-100 prose-a:underline prose-a:decoration-surface-300 dark:prose-a:decoration-surface-700 prose-a:underline-offset-4 hover:prose-a:decoration-surface-900 dark:hover:prose-a:decoration-surface-100 transition-colors
          prose-strong:text-surface-900 dark:prose-strong:text-surface-100 prose-strong:font-semibold
          prose-blockquote:border-l-2 prose-blockquote:border-surface-300 dark:prose-blockquote:border-surface-700 prose-blockquote:pl-6 prose-blockquote:py-1 prose-blockquote:text-surface-900 dark:prose-blockquote:text-surface-100 prose-blockquote:font-medium prose-blockquote:not-italic
          prose-img:rounded-lg prose-img:border prose-img:border-surface-200/50 dark:prose-img:border-surface-800/50 prose-img:mb-0
          prose-code:text-surface-900 dark:prose-code:text-surface-100 prose-code:bg-surface-100 dark:prose-code:bg-surface-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
          prose-ul:list-disc prose-ol:list-decimal prose-li:my-2
          prose-li:marker:text-surface-400 dark:prose-li:marker:text-surface-600
        ">
          <Content />



          <div class="mt-16 flex flex-col sm:flex-row gap-3 md:hidden pt-8 border-t border-surface-200 dark:border-surface-800">
            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-surface-900 dark:bg-surface-100 px-5 py-3 font-mono text-[13px] lowercase text-white dark:text-surface-900"
              >
                <span>live demo ↗</span>
              </a>
            )}

            {project.data.repoUrl && (
              <a
                href={project.data.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg border border-surface-200 dark:border-surface-800 bg-transparent px-5 py-3 font-mono text-[13px] lowercase text-surface-900 dark:text-surface-100"
              >
                <span>source code ↗</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
