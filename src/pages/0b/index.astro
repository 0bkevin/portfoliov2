---
import PageHeader from "@components/PageHeader.astro";
import Layout from "@layouts/Layout.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { formatDateToDisplay, getReadingTime } from "../../lib/utils";
import {
  createBreadcrumbSchema,
  createCollectionPageSchema,
  createPersonSchema,
  createWebsiteSchema,
  seoConfig,
} from "@lib/seo";

const blogs = (await getCollection("blogs")) as CollectionEntry<"blogs">[];

const sortedPost = blogs.sort(
  (a, b) => Number(new Date(b.data.pubDate)) - Number(new Date(a.data.pubDate))
);

const pageTitle = "Backend, Infrastructure, AI & Full-Stack Articles | Kevin Bravo";
const pageDescription =
  "Explore practical articles by Kevin Bravo on backend engineering, infrastructure, AI engineering, full-stack systems, blockchain, and security.";

const structuredData = [
  createWebsiteSchema(),
  createCollectionPageSchema({
    name: "0b Blog",
    url: `${seoConfig.siteUrl}/0b`,
    description: pageDescription,
    about: [
      "Software engineering",
      "Backend systems",
      "Blockchain",
      "Security",
      "Engineering leadership",
    ],
  }),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Kevin Bravo technical articles",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: sortedPost.length,
    itemListElement: sortedPost.map((blog, index) => ({
      "@type": "ListItem",
      position: index + 1,
      url: new URL(`/0b/${blog.id}`, Astro.site).toString(),
      name: blog.data.title,
      description: blog.data.description,
    })),
  },
  createBreadcrumbSchema([
    { name: "Home", item: "/" },
    { name: "Blog", item: "/0b" },
  ]),
  createPersonSchema({
    mainEntityOfPage: `${seoConfig.siteUrl}/0b`,
  }),
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonical="/0b"
  image={seoConfig.defaultOgImage}
  imageAlt={seoConfig.defaultOgImageAlt}
  type="website"
  structuredData={structuredData}
>
  <div class="home-col min-h-screen pb-20 pt-6">
    <PageHeader label="0b · writing" title="Notes and write-ups">
      Writing about backend systems, infrastructure, AI engineering, full-stack software, blockchain, security, and the
      engineering decisions behind production-ready systems.
    </PageHeader>

    <div class="mb-10 flex items-stretch gap-3">
      <div class="group relative flex-1">
        <label for="blog-search" class="sr-only">Search blog posts</label>
        <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-surface-400 transition-colors group-focus-within:text-accent-500 dark:group-focus-within:text-accent-400">
          <svg class="h-4 w-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </div>
        <input
          type="search"
          id="blog-search"
          class="block w-full rounded-lg border border-surface-200 bg-transparent py-2.5 pl-11 pr-4 font-mono text-[13px] text-surface-900 transition-colors placeholder:text-surface-400 hover:border-surface-300 focus:border-accent-500/60 focus:outline-none dark:border-surface-800 dark:text-surface-100 dark:placeholder:text-surface-600 dark:hover:border-surface-700 dark:focus:border-accent-400/60"
          placeholder="search posts"
          autocomplete="off"
        />
      </div>

      <button
        id="blog-sort-button"
        type="button"
        class="group/btn inline-flex shrink-0 items-center justify-center gap-2 rounded-lg border border-surface-200 px-4 font-mono text-[13px] lowercase text-surface-600 transition-colors hover:border-surface-300 hover:text-surface-900 dark:border-surface-800 dark:text-surface-400 dark:hover:border-surface-700 dark:hover:text-surface-200"
        data-sort="newest"
        aria-label="Toggle post sort order"
      >
        <span id="sort-text">newest</span>
        <svg id="sort-icon" class="h-3.5 w-3.5 text-surface-400 transition-transform" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 16.5L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
        </svg>
      </button>
    </div>

    <div class="mb-2 flex items-center justify-between font-mono text-[12px] lowercase text-surface-500">
      <span>all posts</span>
      <span id="post-count">{blogs.length} posts</span>
    </div>

    <section aria-labelledby="all-posts-heading">
      <h2 id="all-posts-heading" class="sr-only">All blog posts</h2>

      <ul id="blog-list">
        {
          sortedPost.map((blog) => (
            <li
              class="blog-post-item"
              data-title={blog.data.title.toLowerCase()}
              data-date={new Date(blog.data.pubDate).getTime()}
            >
              <a href={`/0b/${blog.id}`} class="group block border-b border-surface-200 py-6 dark:border-surface-800/70">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <h3 class="font-mono text-[15px] lowercase text-surface-900 transition-colors group-hover:text-accent-500 dark:text-surface-100 dark:group-hover:text-accent-400">
                    {blog.data.title}
                  </h3>
                  <p class="order-first flex shrink-0 items-center gap-2 font-mono text-[12px] text-surface-500 sm:order-none">
                    <time datetime={new Date(blog.data.pubDate).toISOString()}>{formatDateToDisplay(blog.data.pubDate)}</time>
                    <span aria-hidden="true">·</span>
                    <span>{getReadingTime(blog.body)} min</span>
                  </p>
                </div>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-surface-600 dark:text-surface-400">
                  {blog.data.description}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div id="no-results" class="hidden py-10 text-center font-mono text-[13px] text-surface-500" role="status" aria-live="polite">
      no posts match that search.
    </div>
  </div>
</Layout>

<script>
  function initBlogFilter() {
    const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
    const sortBtn = document.getElementById("blog-sort-button") as HTMLButtonElement | null;
    const sortText = document.getElementById("sort-text");
    const sortIcon = document.getElementById("sort-icon") as HTMLElement | null;
    const blogList = document.getElementById("blog-list") as HTMLElement | null;
    const noResults = document.getElementById("no-results") as HTMLElement | null;
    const postCount = document.getElementById("post-count") as HTMLElement | null;

    if (!searchInput || !sortBtn || !blogList || !noResults || !postCount) {
      return;
    }

    const posts = Array.from(blogList.querySelectorAll(".blog-post-item")) as HTMLElement[];
    let currentSort: "newest" | "oldest" = "newest";

    function updateList() {
      const searchTerm = searchInput!.value.toLowerCase().trim();
      let visibleCount = 0;

      posts.forEach((post) => {
        const title = post.getAttribute("data-title") || "";
        const matches = title.includes(searchTerm);

        if (matches) {
          post.style.display = "";
          visibleCount++;
        } else {
          post.style.display = "none";
        }
      });

      posts.sort((a, b) => {
        const dateA = parseInt(a.getAttribute("data-date") || "0", 10);
        const dateB = parseInt(b.getAttribute("data-date") || "0", 10);

        return currentSort === "newest" ? dateB - dateA : dateA - dateB;
      });

      posts.forEach((post) => blogList!.appendChild(post));

      postCount!.textContent = `${visibleCount} post${visibleCount !== 1 ? "s" : ""}`;
      noResults!.classList.toggle("hidden", visibleCount !== 0);
    }

    sortBtn.addEventListener("click", () => {
      currentSort = currentSort === "newest" ? "oldest" : "newest";

      if (sortText) {
        sortText.textContent = currentSort;
      }

      if (sortIcon) {
        sortIcon.style.transform =
          currentSort === "newest" ? "rotate(0deg)" : "rotate(180deg)";
      }

      updateList();
    });

    searchInput.addEventListener("input", updateList);
  }

  document.addEventListener("astro:page-load", initBlogFilter);
  initBlogFilter();
</script>
