              item.links && (
                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-surface-400 dark:text-surface-500">
                    Selected sites
                  </span>
                  {item.links.map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-semibold text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 transition-colors"
                    >
                      {link.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </div>
              )
            }

            <ul class="mt-6 flex flex-col gap-3.5">
              {
                item.highlights.map((highlight) => (
                  <li class="flex items-start gap-4 text-sm md:text-[15px] text-surface-500 dark:text-surface-400 max-w-3xl group-hover:text-surface-600 dark:group-hover:text-surface-300 transition-colors duration-300">
                    <span class="text-surface-300 dark:text-surface-700 mt-0.5 transition-colors group-hover:text-accent-400">&mdash;</span>
                    <span class="leading-relaxed">{highlight}</span>
                  </li>
                ))
              }
            </ul>

            {
              item.outcome && (
                <div class="mt-6 max-w-3xl rounded-xl border border-surface-200 dark:border-surface-800 bg-surface-50/70 dark:bg-surface-900/50 px-4 py-3.5">
                  <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-surface-400 dark:text-surface-500 mb-1.5">
                    Project outcome
                  </p>
                  <p class="text-xs md:text-sm leading-relaxed text-surface-600 dark:text-surface-400">
                    {item.outcome}
                  </p>
                </div>
              )
            }

            <ul class="mt-6 flex flex-wrap gap-2" aria-label={`Skills used at ${item.company}`}>
              {
                item.skills.map((skill) => (
                  <li class="rounded-full border border-surface-200 dark:border-surface-800 px-3 py-1 text-[11px] font-medium text-surface-500 dark:text-surface-400">
                    {skill}
                  </li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
