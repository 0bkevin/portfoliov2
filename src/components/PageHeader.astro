---
interface Props {
  /** Small mono label above the title, e.g. "0b · writing". */
  label: string;
  title: string;
  backHref?: string;
  backLabel?: string;
}

const { label, title, backHref = "/", backLabel = "home" } = Astro.props;
---

<header class="mb-12 md:mb-16">
  <a
    href={backHref}
    class="group mb-10 inline-flex items-center gap-1.5 font-mono text-[13px] lowercase text-surface-500 transition-colors hover:text-surface-900 dark:hover:text-surface-100"
  >
    <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
    {backLabel}
  </a>
  <p class="section-heading fade-in-up" style="--d: 0ms">
    <span><span class="section-num" aria-hidden="true">//</span> {label}</span>
  </p>
  <h1 class="fade-in-up text-4xl font-bold tracking-tight text-surface-900 dark:text-surface-100 md:text-5xl" style="--d: 60ms">
    {title}
  </h1>
  {
    Astro.slots.has("default") && (
      <div class="fade-in-up mt-5 max-w-2xl text-base leading-relaxed text-surface-600 dark:text-surface-400 md:text-lg" style="--d: 120ms">
        <slot />
      </div>
    )
  }
</header>
